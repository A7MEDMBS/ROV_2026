                            Margin="0,5,0,0" 
                            Padding="5,2" 
                            HorizontalAlignment="Center"
                            CornerRadius="3">
                                                <TextBlock Text="{Binding Value}" 
                                   Foreground="LimeGreen" 
                                   FontWeight="Bold" 
                                   FontSize="16"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Label Content ="{Binding LatestScore.c}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Width="70" Height="30" Margin="0,10,10,0"/>
                            <Label Content ="{Binding LatestScore.r}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Width="70" Height="30" Margin="0,40,10,0"/>
                            <Label Content ="{Binding LatestScore.t}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Width="70" Height="30" Margin="0,70,10,0"/>
                            <Label Content ="{Binding LatestScore.x}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Width="70" Height="30" Margin="0,100,10,0"/>
                            <Label Content ="{Binding LatestScore.s}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Width="70" Height="30" Margin="0,130,10,0"/>
                        </Grid>
                    </Border>
                    <Label Content="Feed 3" Height="30" Margin="320,10,0,0" Width="66" FontFamily="Arial" FontWeight="Bold" Background="{x:Null}" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Border CornerRadius="10,10,10,10" Background="#FF303036"  Margin="788,10,0,0" Height="190" Width="562" VerticalAlignment="Top" HorizontalAlignment="Left">
