<Window
    xmlns:local="clr-namespace:ROV_GUI_Control"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"


    xmlns:View="clr-namespace:ROV_GUI_Control.View"
    xmlns:Converter="clr-namespace:ROV_GUI_Control.Converters"
    x:Class="ROV_GUI_Control.MainWindow"
    mc:Ignorable="d"
    Icon="pack://application:,,,/Media/ROV2025.ico"
    Title="Assiut Robotics - ROV 2025" Height="788" Width="1386">
    <Window.Resources>
        <Converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <Converter:LEDButtonConverter x:Key="LEDButtonConverter"/>
        <Converter:LEDLightnessConverter x:Key="LEDLightnessConverter"/>
        <Converter:VisibilityConverter x:Key="IsHeartbeatIndConverter" />
        <Converter:VisibilityConverter x:Key="IsConnectedIndConverter" />
        <Converter:VisibilityConverter x:Key="IsMPUIndConverter" />
        <Converter:VisibilityConverter x:Key="IsHMCIndConverter" />
        <Converter:VisibilityConverter x:Key="IsMSCIndConverter" />
        <Converter:VisibilityConverter x:Key="IsLightIndConverter" />
        <Converter:VisibilityConverter x:Key="IsGripperClosedIndConverter" />
        <Converter:VisibilityConverter x:Key="IsGripperRotateIndConverter" />
        <Converter:ThrusterStateConverter x:Key="ThrusterStateConverter"/>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsButtonClicked}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="Red" Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <Style x:Key="ThreeDButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4A90E2" Offset="0"/>
                        <GradientStop Color="#357ABD" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5, 0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6" 
                                    BorderBrush="#222" 
                                    BorderThickness="1" 
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#5AA0F2" Offset="0"/>
                                            <GradientStop Color="#468ACE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" 
                                                             Storyboard.TargetProperty="ScaleX" 
                                                             To=".96" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale" 
                                                             Storyboard.TargetProperty="ScaleY" 
                                                             To=".96" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" 
                                                             Storyboard.TargetProperty="ScaleX" 
                                                             To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale" 
                                                             Storyboard.TargetProperty="ScaleY" 
                                                             To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StreamButtonStyle" TargetType="Button" BasedOn="{StaticResource ThreeDButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="TopColor" Color="#444" Offset="0"/>
                        <GradientStop x:Name="BottomColor" Color="#222" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Content" Value="▶ Start"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStream}" Value="True">
                    <Setter Property="Content" Value="⏹ Stop"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ToRed">
                            <Storyboard>
                                <ColorAnimation 
                                    Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                    To="#E53935"
                                    Duration="0:0:0.3"/>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                    To="#B71C1C"
                                    Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard x:Name="ToGray">
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                    To="#444"
                                    Duration="0:0:0.3"/>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                    To="#222"
                                    Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ThrusterIndicatorTemplate">
            <Grid Width="15" Height="15">
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="2.5,5">
                                <PolyLineSegment Points="7.5,0 12.5,5 9,5 9,15 6,15 6,5 2.5,5"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Stroke" Value="White"/>
                            <Setter Property="StrokeThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Converter={StaticResource ThrusterStateConverter}}" Value="Forward">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Fill" Value="#00FF00"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="6,0">
                                <PolyLineSegment Points="9,0 9,10 12.5,10 7.5,15 2.5,10 6,10 6,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Stroke" Value="White"/>
                            <Setter Property="StrokeThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Converter={StaticResource ThrusterStateConverter}}" Value="Backward">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Fill" Value="Orange"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <Ellipse Width="15" Height="15">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Stroke" Value="White"/>
                            <Setter Property="StrokeThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Converter={StaticResource ThrusterStateConverter}}" Value="Stop">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Fill" Value="Red"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Converter={StaticResource ThrusterStateConverter}}" Value="Unknown">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Fill" Value="Gray"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="False">
                    <ColorAnimationUsingKeyFrames
                    Storyboard.TargetName="AnimatedBrush"
                    Storyboard.TargetProperty="GradientStops[0].Color">
                        <LinearColorKeyFrame Value="#FF0000" KeyTime="0:0:0"/>
                        <LinearColorKeyFrame Value="#FF8000" KeyTime="0:0:1"/>
                        <LinearColorKeyFrame Value="#FFFF00"  KeyTime="0:0:2"/>
                        <LinearColorKeyFrame Value="#80FF00" KeyTime="0:0:3"/>
                        <LinearColorKeyFrame Value="#00FF00" KeyTime="0:0:4"/>
                        <LinearColorKeyFrame Value="#00FF80" KeyTime="0:0:5"/>
                        <LinearColorKeyFrame Value="#00FFFF" KeyTime="0:0:6"/>
                        <LinearColorKeyFrame Value="#0080FF" KeyTime="0:0:7"/>
                        <LinearColorKeyFrame Value="#0000FF" KeyTime="0:0:8"/>
                        <LinearColorKeyFrame Value="#8000FF" KeyTime="0:0:9"/>
                        <LinearColorKeyFrame Value="#FF00FF" KeyTime="0:0:10"/>
                        <LinearColorKeyFrame Value="#FF0080" KeyTime="0:0:11"/>
                        <LinearColorKeyFrame Value="#FF0000" KeyTime="0:0:12"/>
                    </ColorAnimationUsingKeyFrames>
                    <ColorAnimationUsingKeyFrames
                    Storyboard.TargetName="AnimatedBrush0"
                    Storyboard.TargetProperty="GradientStops[0].Color">
                        <LinearColorKeyFrame Value="#FF0000" KeyTime="0:0:0"/>
                        <LinearColorKeyFrame Value="#FF8000" KeyTime="0:0:1"/>
                        <LinearColorKeyFrame Value="#FFFF00"  KeyTime="0:0:2"/>
                        <LinearColorKeyFrame Value="#80FF00" KeyTime="0:0:3"/>
                        <LinearColorKeyFrame Value="#00FF00" KeyTime="0:0:4"/>
                        <LinearColorKeyFrame Value="#00FF80" KeyTime="0:0:5"/>
                        <LinearColorKeyFrame Value="#00FFFF" KeyTime="0:0:6"/>
                        <LinearColorKeyFrame Value="#0080FF" KeyTime="0:0:7"/>
                        <LinearColorKeyFrame Value="#0000FF" KeyTime="0:0:8"/>
                        <LinearColorKeyFrame Value="#8000FF" KeyTime="0:0:9"/>
                        <LinearColorKeyFrame Value="#FF00FF" KeyTime="0:0:10"/>
                        <LinearColorKeyFrame Value="#FF0080" KeyTime="0:0:11"/>
                        <LinearColorKeyFrame Value="#FF0000" KeyTime="0:0:12"/>
                    </ColorAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <TabControl HorizontalAlignment="Left" Height="788" Margin="0" VerticalAlignment="Top" Width="1386">
            <TabItem Header="Main" Height="22" VerticalAlignment="Top" FontWeight="Bold">
                <Grid Background="#FF25282D" Width="1385" Height="788" Margin="0,0,-5,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border CornerRadius="10" Width="300" Height="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Background="#FF303036" BorderThickness="2">
                        <Border.BorderBrush>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#FFFC007A" Offset="0"/>
                                <GradientStop Color="#FF0014FF" Offset="0.512"/>
                                <GradientStop Color="#FF00DDFD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Image x:Name="Feed2" Source="{Binding Image2}" Width="296" Height="186 " Stretch="Fill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,296,186" RadiusX="8" RadiusY="8"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <Border CornerRadius="10" Width="300" Height="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="320,10,0,0" Background="#FF303036" BorderThickness="2">
                        <Border.BorderBrush>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#FF0014FF" Offset="1"/>
                                <GradientStop Color="#FF00DDFD" Offset="0.498"/>
                                <GradientStop Color="#FF00DDFD" Offset="0"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Image x:Name="Feed3" Source="{Binding Image3}" Width="296" Height="186 " Stretch="Fill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,296,186" RadiusX="8" RadiusY="8"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <Border CornerRadius="10,10,10,10" Background="#FF303036" Padding="5" Width="148" Height="190" Margin="630,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="2">
                        <Border.BorderBrush>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#FF0014FF" Offset="0"/>
                                <GradientStop Color="#FFFC007A" Offset="0.791"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <DockPanel LastChildFill="True" Height="180" Width="148" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation ="Vertical" DockPanel.Dock="Top">
                                <Button x:Name="StreamButton"  Style="{StaticResource StreamButtonStyle}" Width="130" Height="23" FontWeight="SemiBold" HorizontalAlignment="Center" Command="{Binding StreamCommand}" IsEnabled="{Binding IsStreamButtonBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation ="Horizontal" Width="130">
                                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Width="48" VerticalAlignment="Top" Height="85">
                                        <Label Content="Feed 1" Height="17" Margin="0,5,0,0" Width="40" FontFamily="Arial" FontWeight="Bold" Background="{x:Null}" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Label Content="Feed 2" HorizontalAlignment="Center" Height="17" Margin="0,10,0,0" Width="40" FontFamily="Arial" FontWeight="Bold" Background="{x:Null}" Foreground="White" VerticalAlignment="Top" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Label Content="Feed 3" Height="17" Margin="0,10,0,0" Width="40" FontFamily="Arial" FontWeight="Bold" Background="{x:Null}" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Vertical" Width="82" DockPanel.Dock="Right" Height="85" VerticalAlignment="Top">
                                        <Border CornerRadius="10" Height="22" Width="80" Background="#FFE8E8E8" HorizontalAlignment="Left" Margin="0,5,0,0">
                                            <ComboBox x:Name="Feed1_ComboBox" SelectedIndex="{Binding Index1, Mode=TwoWay}" ItemsSource="{Binding Feed_Comb}"  Height="20" Margin="0" Background="{x:Null}" Foreground="Black" Padding="0" BorderThickness="0" Width="70" BorderBrush="{x:Null}" ClipToBounds="True" SnapsToDevicePixels="True" FontWeight="Bold"/>
                                        </Border>
                                        <Border CornerRadius="10" Height="22" Width="80" Background="#FFE8E8E8" Margin="0,5,0,0" HorizontalAlignment="Left">
                                            <ComboBox x:Name="Feed2_ComboBox" SelectedIndex="{Binding Index2, Mode=TwoWay}" ItemsSource="{Binding Feed_Comb}"  Height="20" Margin="0" Background="{x:Null}" Foreground="Black" Padding="0" BorderThickness="0" Width="70" BorderBrush="{x:Null}" ClipToBounds="True" SnapsToDevicePixels="True" FontWeight="Bold"/>
                                        </Border>
                                        <Border CornerRadius="10" Height="22" Width="80" Background="#FFE8E8E8" Margin="0,5,0,0" HorizontalAlignment="Left">
                                            <ComboBox x:Name="Feed3_ComboBox" SelectedIndex="{Binding Index3, Mode=TwoWay}" ItemsSource="{Binding Feed_Comb}"  Height="20" Margin="0" Background="{x:Null}" Foreground="Black" Padding="0" BorderThickness="0" Width="70" BorderBrush="{x:Null}" ClipToBounds="True" SnapsToDevicePixels="True" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation ="Vertical" Width="130" DockPanel.Dock="Top">
                                <Button x:Name="LEDButton" Style="{StaticResource ThreeDButtonStyle}" Width="130" Height="23" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding IsLight, Converter={StaticResource LEDButtonConverter}}" Command="{Binding LightCommand}"/>
                                <Slider  Minimum="1" Maximum="255" Width="130" HorizontalAlignment="Left" Height="17" VerticalAlignment="Center" Value="{Binding Brightness, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged, FallbackValue=128}" IsSnapToTickEnabled="True" SmallChange="10" Margin="0,5,0,0" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="ValueChanged">
                                            <i:InvokeCommandAction Command="{Binding BrightnessCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Slider>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation ="Horizontal" Width="130">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Gray"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStream}" Value="True">
                                                            <Setter Property="Fill" Value="Red"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="BlinkStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.2"
                                                                             Duration="0:0:0.6"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Offline"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStream}" Value="True">
                                                            <Setter Property="Text" Value="Live"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Label Width="24" Height="24" HorizontalContentAlignment="Center" Background="{x:Null}" Padding="0" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" VerticalContentAlignment="Center">
                                    <MultiBinding Converter="{StaticResource LEDLightnessConverter}">
                                        <Binding Path="IsLight"/>
                                        <Binding Path="Brightness"/>
                                    </MultiBinding>
                                </Label>
                            </StackPanel>
                            <!--<Button x:Name="StreamButton" Style="{StaticResource StreamButtonStyle}" Width="130" Height="23" IsEnabled="{Binding IsStreamButtonBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,0,8"  FontWeight="Normal" HorizontalAlignment="Center" DockPanel.Dock="Bottom" VerticalAlignment="Center" Content="{Binding IsStream, Converter={StaticResource StreamButtonConverter}}" Command="{Binding StreamCommand}"/> -->
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Width="768" Height="432" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,210,0,0" Background="#FF303036" BorderThickness="2" Grid.RowSpan="2">
                        <Border.BorderBrush>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#FFFC007A"/>
                                <GradientStop Color="#FF0014FF" Offset="0.2"/>
                                <GradientStop Color="#FF00DDFD" Offset="0.4"/>
                                <GradientStop Color="#FF00DDFD" Offset="0.6"/>
                                <GradientStop Color="#FFFC007A" Offset="1"/>
                                <GradientStop Color="#FF0014FF" Offset="0.8"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Image x:Name="Feed1" Source="{Binding Image1}" Width="764" Height="428 " Stretch="Fill">
