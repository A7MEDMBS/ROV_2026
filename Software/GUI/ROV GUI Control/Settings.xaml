                        <TextBox Style="{StaticResource TextBoxStyle}" Width="100" Height="18" Text="{Binding RemoteIP, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="100" Height="18" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="100" Height="18" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="60" Height="18" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0" />
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="60" Height="18" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="60" Height="18" Text="{Binding Cam1_Port, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="60" Height="18" Text="{Binding Cam2_Port, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
