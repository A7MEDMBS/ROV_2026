                        <TextBox Style="{StaticResource TextBoxStyle}" Width="60" Height="18" Text="{Binding Vision_RemotePort, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" Margin="0,4,0,0"/>
