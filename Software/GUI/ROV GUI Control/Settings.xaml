                        <Label Content="Remote IP" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="60" RenderTransformOrigin="0.419,0.641" FontSize="10" FontWeight="Bold"/>
                        <Label Content="User name" Height="22" Width="70" FontSize="10" FontWeight="Bold"/>
                        <Label Content="Password" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="70" FontSize="10" FontWeight="Bold"/>
                        <Label Content="Local Port" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="70" FontSize="10" FontWeight="Bold"/>
                        <Label Content="Remote Port" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="70" FontSize="10" FontWeight="Bold"/>
                        <Label Content="CAM1 Port" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="62" FontSize="10" FontWeight="Bold"/>
                        <Label Content="CAM2 Port" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="62" FontSize="10" FontWeight="Bold"/>
                        <Label Content="CAM3 Port" HorizontalAlignment="Left" Height="22" VerticalAlignment="Top" Width="70" FontSize="10" FontWeight="Bold"/>
