                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Width="50" Height="18" Content="Get" Command="{Binding SetCommand}" CommandParameter="0,5" Margin="3,0,0,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <StackPanel Width="60" HorizontalAlignment="Right" VerticalAlignment="Top" Height="30" Margin="0,0,1,0">
                        <TextBox Style="{StaticResource TextBoxStyle}" Width="60" Height="18" Text="{Binding PitchOFFSET, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </GroupBox>




        <Button Content="OK" Width="60" Height="25" Margin="540,360,0,0" Command="{Binding OkCommand}"  HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Cancel" Width="60" Height="25" Margin="610,360,0,0" Command="{Binding CancelCommand}" HorizontalAlignment="Left"  VerticalAlignment="Top">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>